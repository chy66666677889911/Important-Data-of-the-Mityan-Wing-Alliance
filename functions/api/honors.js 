export async function onRequest(context) {
  const { request, env } = context;
  const { DB } = env;
  if (request.method === 'POST') {
    const { title, description, userId } = await request.json();
    const admin = await DB.prepare(`SELECT is_admin FROM users WHERE id = ?`).bind(userId).first();
    if (!admin || admin.is_admin !== 1) return Response.json({ ok: false, msg: '权限不足' });
    await DB.prepare(`INSERT INTO honors (title, description, user_id) VALUES (?, ?, ?)`).bind(title, description, userId).run();
    return Response.json({ ok: true, msg: '荣誉添加成功' });
  }
  const list = await DB.prepare(`SELECT * FROM honors ORDER BY created_at DESC`).all();
  return Response.json(list.results || []);
}
