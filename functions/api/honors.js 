export async function onRequestGet({ env }) {
  const { results } = await env.DB.prepare(
    "SELECT * FROM honors ORDER BY id DESC"
  ).all();
  return Response.json(results);
}

export async function onRequestPost({ request, env }) {
  const { title, description, image_url, userId } = await request.json();

  const user = await env.DB.prepare(
    "SELECT is_admin FROM users WHERE id = ?"
  ).bind(userId).first();

  if (!user?.is_admin) return Response.json({ ok: false, msg: "无权限" });

  await env.DB.prepare(
    "INSERT INTO honors (title, description, image_url) VALUES (?, ?, ?)"
  ).bind(title, description, image_url).run();

  return Response.json({ ok: true, msg: "荣誉已添加" });
}
