<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>弥天翼航空联盟 - 大厅</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="app">
        <!-- 左侧按钮列 -->
        <div class="sidebar">
            <button onclick="showSection('lobby')">大厅</button>
            <button onclick="showSection('events')">连飞活动</button>
            <button onclick="showSection('metar')">机场METAR</button>
            <button onclick="showSection('route')">航路查询</button>
            <button onclick="showSection('apply')">职员申请</button>
        </div>

        <!-- 右侧内容区 -->
        <div class="content">
            <!-- 大厅 -->
            <div id="lobby" class="section">
                <h2>欢迎飞行员，<span id="pilotName"></span></h2>
                <div class="weather-box">
                    <h3>当地天气</h3>
                    <p id="weather">加载中...</p>
                </div>
                <div class="airport-box">
                    <h3>附近机场</h3>
                    <p id="nearbyAirports">加载中...</p>
                </div>
                <div class="chat-box">
                    <h3>聊天室</h3>
                    <div id="chatMessages"></div>
                </div>
                <div class="online-box">
                    在线人数：<span id="onlineCount">0</span>
                </div>
                <div class="announcement-box">
                    <h3>系统公告</h3>
                    <div id="announcements"></div>
                    <!-- 管理员发布公告 -->
                    <div id="adminAnnounce" style="display:none;">
                        <input type="text" id="announceText" placeholder="输入公告">
                        <button onclick="postAnnouncement()">发布</button>
                    </div>
                </div>
            </div>

            <!-- 连飞活动 -->
            <div id="events" class="section" style="display:none;">
                <h2>连飞活动</h2>
                <div id="eventList"></div>
            </div>

            <!-- METAR -->
            <div id="metar" class="section" style="display:none;">
                <h2>METAR 查询</h2>
                <input type="text" id="icaoMetar" placeholder="机场ICAO代码">
                <button onclick="getMetar()">查询</button>
                <pre id="metarResult"></pre>
            </div>

            <!-- 航路 -->
            <div id="route" class="section" style="display:none;">
                <h2>航路查询</h2>
                <input type="text" id="dep" placeholder="起飞机场ICAO">
                <input type="text" id="arr" placeholder="降落机场ICAO">
                <button onclick="getRoute()">查询</button>
                <pre id="routeResult"></pre>
            </div>

            <!-- 职员申请 -->
            <div id="apply" class="section" style="display:none;">
                <h2>职员申请</h2>
                <form id="applyForm">
                    <select id="position">
                        <option value="atc">空管</option>
                        <option value="staff">工作人员</option>
                    </select>
                    <textarea id="reason" placeholder="你为什么要申请？"></textarea>
                    <label>
                        <input type="checkbox" id="loyalty"> 我愿意效忠我们联盟
                    </label>
                    <button type="submit">提交申请</button>
                </form>
            </div>
        </div>
    </div>
    <script src="js/main.js"></script>
</body>
</html>

